config {
  type: "incremental",
  uniqueKey: ["timestamp", "stationId"], 
  bigquery: {
      partitionBy: "DATE(timestamp)", 
      clusterBy: ["stationId"]
    },
  dependencies: [
    "silver_nws_observations" 
  ],
  columns: {
    timestamp: "Time that the weather data was generated by the NWS station (Primary Key 1)",
    stationId: "The NWS observation station ID (Primary Key 2)",
    stationName: "The NWS observation station Name (NULL for historic data)",
    latitude: "Latitude coordinate of weather station",
    longitude: "Longitudal coordinate of weather station.",
    temperature: "Temperature recorded in Celcius",
    humidity: "Humidity percentage measured.",
    precipitation: "Precipitation measured in milimeters.",
    wind_speed: "Wind speed at time of recording in Kilometers.",
    pressure: "Atomospheric pressure measured in Pascals"
    },
  schema: "NWS_API"
}

-- 1. If it is the FIRST RUN (!incremental), start with the historical data.
-- 2. If it is a SUBSEQUENT RUN (incremental), start directly with the streaming data.

${when(!incremental(), `
SELECT
  timestamp,
  stationId,
  NULL AS stationName,
  latitude,
  longitude,
  temperature,
  humidity,
  precipitation,
  wind_speed,
  pressure
FROM
  \`weatherimpact-476122.NWS_API.silver_weather_historical\`
UNION ALL
`)}

-- This block always runs, forming the core SELECT statement.
SELECT DISTINCT
  timestamp,
  stationId,
  stationName,
  latitude,
  longitude,
  temperature,
  humidity,
  precipitation,
  wind_speed,
  pressure
FROM
  `weatherimpact-476122.NWS_API2.silver_nws_observations`

-- 3. INCREMENTAL FILTER: Filters the streaming data for efficiency.
${when(incremental(), `WHERE timestamp > (SELECT MAX(timestamp) FROM ${self()})`)}