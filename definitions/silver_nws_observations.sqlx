-- This is an example SQLX file to help you learn the basics of Dataform.
-- Visit https://cloud.google.com/dataform/docs/sql-workflows for more information on how to configure your SQL workflow.

-- You can delete this file, then commit and push your changes to your repository when you are ready.

-- Config blocks allow you to configure, document, and test your data assets.
config {
  type: "incremental", // Creates a view in BigQuery. Try changing to "table" instead.
  uniqueKey: ["timestamp","stationId"],
  bigquery: {
      partitionBy: "DATE(timestamp)", 
      clusterBy: ["stationId"] 
    },
  columns: {
    timestamp: "Time that the weather data was generated by the NWS station", // Column descriptions are pushed to BigQuery.
    stationId: "The NWS observation station ID",
    stationName: "The NWS observation station Name",
    latitude: "Latitude coordinate of weather station",
    longitude: "Longitudal coordinate of weather station.",
    temperature: "Temperature recorded in Celcius",
    humidity: "Humidity percentage measured.",
    precipitation: "Precipitation measured in milimeters.",
    wind_speed: "Wind speed at time of recording in Kilometers.",
    pressure: "Atomospheric pressure measured in Pascals"
    },
  schema: "NWS_API"
}

-- The rest of a SQLX file contains your SELECT statement used to create the table.

SELECT DISTINCT 
  timestamp AS timestamp,
  stationId AS stationId,
  stationName AS stationName,
  lat AS latitude,
  lon AS longitude,
  temp AS temperature,
  humidity AS humidity,
  precip_3hr AS precipitation,
  wind_speed AS wind_speed,
  pressure_pa AS pressure
FROM 
  `weatherimpact-476122.NWS_API.bronze_NWS_API_observations`
${when(incremental(), `where timestamp > (select max(timestamp) from ${self()})`)}
